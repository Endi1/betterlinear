;;; betterlinear-sub-issues-fetch-test.el --- Sub-issue fetching -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'betterlinear)

(defun betterlinear-fetch-test--issue (id &optional parent)
  `((id . ,id) (identifier . ,(concat "ENG-" id))
    (title . ,(concat "Remote " id)) (url . "https://example.com")
    (state . ((name . "In Progress")))
    (parent . ,(when parent `((id . ,parent))))))

(defun betterlinear-fetch-test--ids ()
  (let (ids)
    (org-map-entries (lambda () (when-let* ((id (org-entry-get (point) "LINEAR_ID" nil)))
                                 (push id ids))))
    (nreverse ids)))

(ert-deftest betterlinear-sub-issues-fetches-all-pages-and-descendants ()
  (let (calls)
    (cl-letf (((symbol-function 'betterlinear--graphql)
               (lambda (query variables)
                 (should (equal query betterlinear--sub-issues-query))
                 (let* ((id (alist-get 'id variables))
                        (after (alist-get 'after variables))
                        (nodes (cond ((equal (list id after) '("p" nil))
                                      (list (betterlinear-fetch-test--issue "a" "p")))
                                     ((equal (list id after) '("p" "next"))
                                      (list (betterlinear-fetch-test--issue "b" "p")))
                                     ((equal id "a")
                                      (list (betterlinear-fetch-test--issue "c" "a")
                                            (betterlinear-fetch-test--issue "p" "a"))))))
                   (push (list id after) calls)
                   `((issue . ((children . ((nodes . ,nodes)
                                           (pageInfo . ((hasNextPage . ,(if (equal (list id after) '("p" nil)) t :json-false))
                                                        (endCursor . "next"))))))))))))
      (let ((issues (betterlinear-sub-issues "p")))
        (should (equal '("a" "b" "c") (sort (mapcar (lambda (i) (alist-get 'id i)) issues) #'string<)))
        (should (= 5 (length calls)))
        (should (member '("p" "next") calls))
        (should (member '("c" nil) calls))))))

(ert-deftest betterlinear-sub-issues-rejects-broken-pagination ()
  (cl-letf (((symbol-function 'betterlinear--graphql)
             (lambda (&rest _)
               '((issue . ((children . ((pageInfo . ((hasNextPage . t) (endCursor . "same")))))))))))
    (should-error (betterlinear-sub-issues "p"))))

(ert-deftest betterlinear-fetch-sub-issues-merges-tree-and-preserves-local-work ()
  (with-temp-buffer
    (org-mode)
    (insert "* Parent\n:PROPERTIES:\n:LINEAR_ID: p\n:END:\n** Old child\nSCHEDULED: <2026-06-01 Mon>\n:PROPERTIES:\n:LINEAR_ID: a\n:END:\n*** TODO Local draft\nKeep this\n* Outside\n:PROPERTIES:\n:LINEAR_ID: q\n:END:\n")
    (goto-char (point-min))
    (let ((buffer-read-only t)
          (issues (list (betterlinear-fetch-test--issue "a" "p")
                        (betterlinear-fetch-test--issue "b" "p")
                        (betterlinear-fetch-test--issue "c" "b")
                        (betterlinear-fetch-test--issue "d" "a"))))
      (cl-letf (((symbol-function 'betterlinear-sub-issues) (lambda (_) issues)))
        (dotimes (_ 2)
          (goto-char (point-min))
          (re-search-forward "^\\* Parent")
          (should (= 4 (betterlinear-fetch-sub-issues))))))
    (should (equal '("p" "a" "d" "b" "c" "q") (betterlinear-fetch-test--ids)))
    (goto-char (point-min))
    (re-search-forward "Remote a")
    (should (= 2 (org-outline-level)))
    (should (equal "<2026-06-01 Mon>" (org-entry-get (point) "SCHEDULED")))
    (should (search-forward "*** TODO Local draft\nKeep this" nil t))
    (re-search-forward "Remote c")
    (should (= 3 (org-outline-level)))
    (should (search-forward "* Outside" nil t))))

(ert-deftest betterlinear-refresh-all-issues-keeps-parent-marker-after-keyword-insertion ()
  (with-temp-buffer
    (org-mode)
    (insert "* Parent\n:PROPERTIES:\n:LINEAR_ID: p\n:END:\n** Child\n:PROPERTIES:\n:LINEAR_ID: c\n:END:\n*** TODO Draft\nKeep this\n")
    (goto-char (point-min))
    (cl-letf (((symbol-function 'betterlinear-issue)
               (lambda (id) (betterlinear-fetch-test--issue id))))
      (should (= 2 (betterlinear-refresh-all-issues))))
    (should (equal '("p" "c") (betterlinear-fetch-test--ids)))
    (should (string-match-p "^#\\+TODO: .*IN-PROGRESS" (buffer-string)))
    (should (string-match-p (regexp-quote "*** TODO Draft\nKeep this") (buffer-string)))))

(ert-deftest betterlinear-fetch-sub-issues-network-error-leaves-buffer-alone ()
  (with-temp-buffer
    (org-mode)
    (insert "* Parent\n:PROPERTIES:\n:LINEAR_ID: p\n:END:\n** TODO Draft\n")
    (goto-char (point-min))
    (let ((original (buffer-string)))
      (cl-letf (((symbol-function 'betterlinear-sub-issues) (lambda (_) (error "Network failure"))))
        (should-error (betterlinear-fetch-sub-issues)))
      (should (equal original (buffer-string))))))

(ert-deftest betterlinear-sub-issues-view-refresh-preserves-and-relevels-drafts ()
  (with-temp-buffer
    (org-mode)
    (insert "* Parent\n:PROPERTIES:\n:LINEAR_ID: p\n:END:\n** TODO Local draft\nSCHEDULED: <2026-06-01 Mon>\nDraft body\n*** DONE Grandchild draft\n")
    (let ((issues (list (betterlinear-fetch-test--issue "g")
                        (betterlinear-fetch-test--issue "p" "g"))))
      (dotimes (_ 2) (betterlinear--insert-my-issues-org issues)))
    (should (equal '("g" "p") (betterlinear-fetch-test--ids)))
    (goto-char (point-min))
    (should (search-forward "*** TODO Local draft" nil t))
    (should (search-forward "SCHEDULED: <2026-06-01 Mon>\nDraft body\n**** DONE Grandchild draft" nil t))
    (should (equal "DONE" (org-get-todo-state)))))

(ert-deftest betterlinear-sub-issues-view-refresh-preserves-drafts-outside-narrowing ()
  (with-temp-buffer
    (org-mode)
    (insert "* Parent\n:PROPERTIES:\n:LINEAR_ID: p\n:END:\n** TODO Hidden draft\nKeep this\n* Other\n:PROPERTIES:\n:LINEAR_ID: q\n:END:\n")
    (goto-char (point-max))
    (org-back-to-heading t)
    (org-narrow-to-subtree)
    (betterlinear--insert-my-issues-org
     (list (betterlinear-fetch-test--issue "p") (betterlinear-fetch-test--issue "q")))
    (widen)
    (should (string-match-p (regexp-quote "** TODO Hidden draft\nKeep this") (buffer-string)))))

(ert-deftest betterlinear-sub-issues-view-refresh-does-not-duplicate-issues-under-drafts ()
  (with-temp-buffer
    (org-mode)
    (insert "* Parent\n:PROPERTIES:\n:LINEAR_ID: p\n:END:\n** TODO Local draft\nDraft body\n*** Child\n:PROPERTIES:\n:LINEAR_ID: c\n:END:\n**** TODO Child draft\nKeep this too\n*** Ordinary draft notes\nKeep notes after child\n")
    (let ((original (buffer-string)))
      (should-error (betterlinear--insert-my-issues-org (list (betterlinear-fetch-test--issue "p"))) :type 'user-error)
      (should (equal original (buffer-string))))
    (dotimes (_ 2)
      (betterlinear--insert-my-issues-org
       (list (betterlinear-fetch-test--issue "p") (betterlinear-fetch-test--issue "c" "p"))))
    (should (equal '("p" "c") (betterlinear-fetch-test--ids)))
    (should (string-match-p (regexp-quote "** TODO Local draft\nDraft body") (buffer-string)))
    (should (string-match-p (regexp-quote "*** TODO Child draft\nKeep this too") (buffer-string)))
    (should (string-match-p (regexp-quote "*** Ordinary draft notes\nKeep notes after child") (buffer-string)))))

(ert-deftest betterlinear-sub-issues-view-render-error-does-not-destroy-drafts ()
  (with-temp-buffer
    (org-mode)
    (insert "* Parent\n:PROPERTIES:\n:LINEAR_ID: p\n:END:\n** TODO Local draft\n")
    (let ((original (buffer-string)))
      (cl-letf (((symbol-function 'betterlinear--insert-issue)
                 (lambda (&rest _) (error "Rendering failure"))))
        (should-error (betterlinear--insert-my-issues-org (list (betterlinear-fetch-test--issue "p")))))
      (should (equal original (buffer-string))))))

(ert-deftest betterlinear-capture-preserves-sub-issue-drafts-in-output ()
  (let ((capture (generate-new-buffer " *capture-sub-issues-test*")) output sent
        (show (symbol-function 'betterlinear--show-captured-issue-org)))
    (unwind-protect
        (progn
          (with-current-buffer capture
            (betterlinear-capture-mode)
            (insert "* TODO Parent\n:PROPERTIES:\n:TEAM_ID: team\n:END:\nParent body\n** TODO Child draft\nChild body\n*** DONE Grandchild\n")
            (cl-letf (((symbol-function 'betterlinear--state-id-for-todo-keyword)
                       (lambda (&rest _) nil))
                      ((symbol-function 'betterlinear-create-issue)
                       (lambda (&rest args)
                         (setq sent args)
                         (betterlinear-fetch-test--issue "new")))
                      ((symbol-function 'pop-to-buffer) (lambda (&rest _) nil))
                      ((symbol-function 'betterlinear--show-captured-issue-org)
                       (lambda (issue) (setq output (funcall show issue)))))
              (betterlinear-capture-finalize)))
          (should-not (buffer-live-p capture))
          (should (string-match-p "Parent body" (nth 2 sent)))
          (should-not (string-match-p "Child body" (nth 2 sent)))
          (with-current-buffer output
            (goto-char (point-min))
            (should (search-forward "** TODO Child draft\nChild body\n*** DONE Grandchild" nil t))
            (should (equal "DONE" (org-get-todo-state)))))
      (when (buffer-live-p capture) (kill-buffer capture))
      (when (buffer-live-p output) (kill-buffer output)))))

(ert-deftest betterlinear-sub-issues-view-refuses-to-drop-drafts-with-filtered-parent ()
  (with-temp-buffer
    (org-mode)
    (insert "* Parent\n:PROPERTIES:\n:LINEAR_ID: p\n:END:\n** TODO Local draft\n")
    (let ((original (buffer-string)))
      (should-error (betterlinear--insert-my-issues-org nil) :type 'user-error)
      (should (equal original (buffer-string))))))
