;;; betterlinear-refresh-test.el --- Bulk refresh tests -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'betterlinear)

(defun betterlinear-test--remote-issue (id)
  `((id . ,id) (identifier . ,(concat "ENG-" id))
    (title . ,(concat "Remote " id)) (url . "https://example.com")
    (priority . 0)))

(ert-deftest betterlinear-refresh-all-issues-whole-buffer ()
  (with-temp-buffer
    (org-mode)
    (insert "Preamble\n* Local\nKeep this.\n* Old one\nSCHEDULED: <2026-06-01 Mon>\n:PROPERTIES:\n:LINEAR_ID: 1\n:END:\nOld body\n* Old two\n:PROPERTIES:\n:LINEAR_ID: 2\n:END:\n* Other\nKeep that.\n")
    (goto-char (point-min))
    (search-forward "* Old one")
    (beginning-of-line)
    (org-narrow-to-subtree)
    (let (fetched)
      (cl-letf (((symbol-function 'betterlinear-issue)
                 (lambda (id)
                   (push id fetched)
                   (betterlinear-test--remote-issue id))))
        (should (= 2 (betterlinear-refresh-all-issues))))
      (should (equal '("1" "2") (sort fetched #'string<))))
    (should (buffer-narrowed-p))
    (widen)
    (let ((text (buffer-string)))
      (dolist (expected '("Preamble" "* Local\nKeep this." "Remote 1" "Remote 2"
                          "SCHEDULED: <2026-06-01 Mon>" "* Other\nKeep that."))
        (should (string-match-p (regexp-quote expected) text)))
      (should-not (string-match-p "Old body" text)))))

(ert-deftest betterlinear-refresh-all-issues-nested ()
  (with-temp-buffer
    (org-mode)
    (insert "* Parent\n:PROPERTIES:\n:LINEAR_ID: 1\n:END:\n** Child\n:PROPERTIES:\n:LINEAR_ID: 2\n:END:\n** Local child\nKeep\n")
    (let ((org-use-property-inheritance t) fetched)
      (cl-letf (((symbol-function 'betterlinear-issue)
                 (lambda (id)
                   (push id fetched)
                   (betterlinear-test--remote-issue id))))
        (should (= 2 (betterlinear-refresh-all-issues)))))
    (goto-char (point-min))
    (should (re-search-forward "^\\* .*Remote 1" nil t))
    (should (re-search-forward "^\\*\\* .*Remote 2" nil t))
    (should (search-forward "** Local child\nKeep" nil t))))

(ert-deftest betterlinear-refresh-all-issues-fetch-failure-is-nondestructive ()
  (with-temp-buffer
    (org-mode)
    (insert "* One\n:PROPERTIES:\n:LINEAR_ID: 1\n:END:\n* Two\n:PROPERTIES:\n:LINEAR_ID: 2\n:END:\n")
    (let ((original (buffer-string)))
      (cl-letf (((symbol-function 'betterlinear-issue)
                 (lambda (id)
                   (if (equal id "1") (error "Network failure")
                     (betterlinear-test--remote-issue id)))))
        (should-error (betterlinear-refresh-all-issues)))
      (should (equal original (buffer-string))))))

(ert-deftest betterlinear-refresh-all-issues-empty-and-wrong-mode ()
  (with-temp-buffer
    (should-error (betterlinear-refresh-all-issues) :type 'user-error)
    (org-mode)
    (insert "* Local\nUnchanged\n")
    (cl-letf (((symbol-function 'betterlinear-issue)
               (lambda (_) (ert-fail "Unexpected fetch"))))
      (should (= 0 (betterlinear-refresh-all-issues))))))
