;;; betterlinear-comments-test.el --- Issue comments -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'betterlinear)

(defun betterlinear-comments-test--comment (id created &rest props)
  `((id . ,id) (createdAt . ,created) (url . ,(concat "https://linear.app/c/" id))
    (body . ,(or (plist-get props :body) (concat "Body " id)))
    (parentId . ,(plist-get props :parent))
    (resolvedAt . ,(plist-get props :resolved))
    (user . ,(when-let* ((name (plist-get props :user))) `((name . ,name))))
    (externalUser . ,(when-let* ((name (plist-get props :external))) `((name . ,name))))
    (botActor . ,(when-let* ((name (plist-get props :bot))) `((name . ,name) (type . "integration"))))))

(defvar betterlinear-comments-test--comments
  (list (betterlinear-comments-test--comment "r1" "2026-01-02T10:00:00.000Z"
                                             :parent "c1" :user "Bob")
        (betterlinear-comments-test--comment "c2" "2026-01-03T10:00:00.000Z"
                                             :bot "GitHub" :body "# PR linked")
        (betterlinear-comments-test--comment "c1" "2026-01-01T10:00:00.000Z"
                                             :user "Jane" :resolved "2026-01-04T10:00:00.000Z")
        (betterlinear-comments-test--comment "r0" "2026-01-01T12:00:00.000Z"
                                             :parent "c1" :external "Sam" :bot "Slack")))

(defun betterlinear-comments-test--fetch ()
  (cl-letf (((symbol-function 'betterlinear-issue-comments)
             (lambda (id) (should (equal id "p")) betterlinear-comments-test--comments))
            ((symbol-function 'betterlinear-markdown-to-org)
             (lambda (md) (replace-regexp-in-string "^# " "* " md))))
    (betterlinear-fetch-comments)))

(ert-deftest betterlinear-issue-comments-fetches-all-pages ()
  (let (calls)
    (cl-letf (((symbol-function 'betterlinear--graphql)
               (lambda (query variables)
                 (should (equal query betterlinear--issue-comments-query))
                 (let ((after (alist-get 'after variables)))
                   (push after calls)
                   `((issue . ((comments . ((nodes . ,(if after
                                                          (list (betterlinear-comments-test--comment "a" "2026-01-01T00:00:00Z"))
                                                        (list (betterlinear-comments-test--comment "b" "2026-01-02T00:00:00Z"))))
                                            (pageInfo . ((hasNextPage . ,(if after :json-false t))
                                                         (endCursor . "next"))))))))))))
      (should (equal '("a" "b") (mapcar (lambda (c) (alist-get 'id c))
                                        (betterlinear-issue-comments "p"))))
      (should (equal '("next" nil) calls)))))

(ert-deftest betterlinear-fetch-comments-renders-threads-oldest-first ()
  (with-temp-buffer
    (org-mode)
    (insert "* TODO Parent\n:PROPERTIES:\n:LINEAR_ID: p\n:END:\nDescription\n** TODO Child\n:PROPERTIES:\n:LINEAR_ID: c\n:END:\n")
    (goto-char (point-min))
    (should (= 4 (betterlinear-comments-test--fetch)))
    (goto-char (point-min))
    (should (re-search-forward "^Description\n\\*\\* Comments (4) :linear_comments:\n\\*\\*\\* Jane \\[2026-01-01 [A-Za-z]+ [0-9:]+\\] :resolved:$" nil t))
    (should (re-search-forward "^\\*\\*\\*\\* Sam (via Slack) \\[" nil t))
    (should (re-search-forward "^\\*\\*\\*\\* Bob \\[" nil t))
    (should (re-search-forward "^\\*\\*\\* GitHub \\[" nil t))
    (should (equal "c2" (org-entry-get (point) "LINEAR_COMMENT_ID")))
    (should (re-search-forward "^\\*\\*\\*\\* PR linked$" nil t))
    (should (re-search-forward "^\\*\\* TODO Child$" nil t))))

(ert-deftest betterlinear-fetch-comments-replaces-in-place-and-is-not-description ()
  (with-temp-buffer
    (org-mode)
    (insert "* Parent\n:PROPERTIES:\n:LINEAR_ID: p\n:END:\nDescription\n** Notes\nKeep in description\n")
    (goto-char (point-max))
    (let ((buffer-read-only t))
      (betterlinear-comments-test--fetch)
      ;; Run from inside the comments subtree.
      (goto-char (point-min))
      (re-search-forward "^\\*+ Bob")
      (betterlinear-comments-test--fetch))
    (goto-char (point-min))
    (should (= 1 (how-many ":linear_comments:")))
    (should (= 1 (how-many "^\\*+ Bob ")))
    (cl-letf (((symbol-function 'betterlinear-org-to-markdown) #'identity))
      (let ((description (betterlinear--current-org-entry-description)))
        (should (string-match-p "Keep in description" description))
        (should-not (string-match-p "Comments\\|Jane\\|LINEAR_COMMENT" description))))))

(ert-deftest betterlinear-refresh-preserves-comments-subtree ()
  (with-temp-buffer
    (org-mode)
    (insert "* Parent\n:PROPERTIES:\n:LINEAR_ID: p\n:END:\nOld\n")
    (goto-char (point-min))
    (betterlinear-comments-test--fetch)
    (goto-char (point-min))
    (betterlinear--replace-current-entry-with-issue
     '((id . "p") (identifier . "ENG-1") (title . "New") (description . "Fresh")
       (state . ((name . "Todo")))))
    (goto-char (point-min))
    (should (search-forward "Fresh" nil t))
    (should-not (search-forward "Old" nil t))
    (goto-char (point-min))
    (should (= 1 (how-many ":linear_comments:")))))

(ert-deftest betterlinear-list-refresh-keeps-comments-without-erroring ()
  (with-temp-buffer
    (org-mode)
    (insert "* Parent\n:PROPERTIES:\n:LINEAR_ID: p\n:END:\n* Gone\n:PROPERTIES:\n:LINEAR_ID: gone\n:END:\n")
    (goto-char (point-min))
    (betterlinear-comments-test--fetch)
    (goto-char (point-min))
    (re-search-forward "^\\* Gone")
    (cl-letf (((symbol-function 'betterlinear-issue-comments)
               (lambda (_) (list (betterlinear-comments-test--comment "g" "2026-01-01T00:00:00Z" :user "Gil")))))
      (betterlinear-fetch-comments))
    (betterlinear--insert-my-issues-org
     (list '((id . "p") (identifier . "ENG-1") (title . "Parent") (state . ((name . "Todo"))))))
    (goto-char (point-min))
    (should (= 1 (how-many ":linear_comments:")))
    (should (search-forward "Jane" nil t))
    (goto-char (point-min))
    (should-not (search-forward "Gil" nil t))))

(ert-deftest betterlinear-fetch-comments-inserts-nothing-when-empty ()
  (with-temp-buffer
    (org-mode)
    (insert "* Parent\n:PROPERTIES:\n:LINEAR_ID: p\n:END:\nBody\n")
    (let ((before (buffer-string)))
      (cl-letf (((symbol-function 'betterlinear-issue-comments) (lambda (_) nil)))
        (should (= 0 (betterlinear-fetch-comments))))
      (should (equal before (buffer-string))))))

(ert-deftest betterlinear-create-comment-sends-input ()
  (let (sent)
    (cl-letf (((symbol-function 'betterlinear--graphql)
               (lambda (query variables)
                 (should (equal query betterlinear--create-comment-mutation))
                 (setq sent (alist-get 'input variables))
                 '((commentCreate . ((success . t) (comment . ((id . "new")))))))))
      (should (equal "new" (alist-get 'id (betterlinear-create-comment "p" "Hi"))))
      (should (equal '((issueId . "p") (body . "Hi")) sent))
      (betterlinear-create-comment "p" "Hi" "c1")
      (should (equal "c1" (alist-get 'parentId sent))))
    (cl-letf (((symbol-function 'betterlinear--graphql)
               (lambda (&rest _) '((commentCreate . ((success . :json-false)))))))
      (should-error (betterlinear-create-comment "p" "Hi")))))

(defun betterlinear-comments-test--post-from (search &optional new-thread)
  "Compose a comment from the heading matching SEARCH; return (ISSUE BODY PARENT)."
  (let (posted)
    (goto-char (point-min))
    (re-search-forward search)
    (let ((compose (betterlinear-add-comment new-thread)))
      (with-current-buffer compose
        (should (derived-mode-p 'betterlinear-comment-mode))
        (insert "Looks *good*\n")
        (cl-letf (((symbol-function 'betterlinear-create-comment)
                   (lambda (issue body parent)
                     (setq posted (list issue body parent))
                     '((id . "new"))))
                  ((symbol-function 'betterlinear-org-to-markdown)
                   (lambda (org) (concat "md:" org))))
          (betterlinear-comment-finalize)))
      (should-not (buffer-live-p compose)))
    posted))

(ert-deftest betterlinear-add-comment-posts-top-level-and-replies-to-thread-root ()
  (with-temp-buffer
    (org-mode)
    (insert "* Parent\n:PROPERTIES:\n:LINEAR_ID: p\n:LINEAR_IDENTIFIER: ENG-1\n:END:\nBody\n")
    (goto-char (point-min))
    (betterlinear-comments-test--fetch)
    (let ((source (current-buffer)))
      (cl-letf (((symbol-function 'pop-to-buffer) #'set-buffer)
                ((symbol-function 'betterlinear-fetch-comments)
                 (lambda () (should (eq (current-buffer) source))
                   (should (equal "p" (org-entry-get (point) "LINEAR_ID"))) 0)))
        ;; On the issue heading: new top-level comment.
        (should (equal '("p" "md:Looks *good*" nil)
                       (betterlinear-comments-test--post-from "^\\* Parent")))
        ;; Inside a reply: reply goes to the thread root.
        (set-buffer source)
        (should (equal '("p" "md:Looks *good*" "c1")
                       (betterlinear-comments-test--post-from "^Body r1")))
        ;; Prefix argument forces a new thread.
        (set-buffer source)
        (should (equal '("p" "md:Looks *good*" nil)
                       (betterlinear-comments-test--post-from "^Body r1" t)))))))

(ert-deftest betterlinear-comment-finalize-rejects-empty-comment ()
  (with-temp-buffer
    (org-mode)
    (insert "* Parent\n:PROPERTIES:\n:LINEAR_ID: p\n:END:\n")
    (cl-letf (((symbol-function 'pop-to-buffer) #'set-buffer))
      (let ((compose (betterlinear-add-comment)))
        (unwind-protect
            (with-current-buffer compose
              (insert "  \n")
              (should-error (betterlinear-comment-finalize) :type 'user-error)
              (should (buffer-live-p compose)))
          (kill-buffer compose))))))
